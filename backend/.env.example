# Credenciais do projeto no Supabase (Project Settings > API)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua_publishable_key_aqui

# Origens liberadas no CORS, separadas por virgula.
# Em producao, incluir a URL da Vercel.
CORS_ORIGINS=http://localhost:3000

# Identificacao enviada ao Nominatim (OpenStreetMap) na geocodificacao.
# A politica de uso deles exige um contato real aqui.
GEOCODING_USER_AGENT=escala-paroquia/1.0 (contato@exemplo.com)

# Fuso da paroquia em horas de diferenca do UTC. -3 = horario de Brasilia.
UTC_OFFSET_HORAS=-3
